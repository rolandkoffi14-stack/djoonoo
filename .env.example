# ==============================================================================
# DJOONOO (VERSION STANDALONE / LICENCE À VIE) — VARIABLES D'ENVIRONNEMENT (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DONNÉES POSTGRESQL (Supabase / Neon / Connection Pooling / Prisma)
# ------------------------------------------------------------------------------
# Connexion poolée (Transaction mode - port 6543 - PgBouncer pour Next.js App Router sur Vercel)
# ⚠️ Sur Vercel, ajouter impérativement "&connection_limit=1" pour éviter l'épuisement des connexions
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Connexion directe (Session mode - port 5432 - requis pour les migrations Prisma)
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AUTHENTIFICATION & SÉCURITÉ DE SESSION
# ------------------------------------------------------------------------------
# URL publique de l'instance client (ex: https://caisse.moncommerce.com ou https://moncommerce.vercel.app)
NEXTAUTH_URL="https://caisse.moncommerce.com"
NEXT_PUBLIC_APP_URL="https://caisse.moncommerce.com"

# Clé secrète de signature des sessions JWT (générer avec: openssl rand -hex 32)
# Exigence de sécurité fail-fast : minimum 32 caractères obligatoires
AUTH_SECRET="change-this-to-a-super-secret-key-at-least-32-chars-long"
NEXTAUTH_SECRET="change-this-to-a-super-secret-key-at-least-32-chars-long"

# ------------------------------------------------------------------------------
# 3. LICENCE À VIE (Système Hors-SaaS)
# ------------------------------------------------------------------------------
# Clé de licence officielle délivrée à l'achat pour le commerçant
# Peut être saisie à l'écran lors du premier démarrage (/initialisation) ou passée ici :
LICENSE_KEY=""

# Secret éditeur de signature des licences (conservé par vous pour émettre les clés)
DJOONOO_LICENSE_SECRET="djoonoo_editeur_master_secret_2krdigital_2026_licence_a_vie"

# ------------------------------------------------------------------------------
# 4. EMAILS TRANSACTIONNELS (Resend API — Pour invitations des employés & 2FA)
# ------------------------------------------------------------------------------
# Clé API Resend (laisser vide ou "test_key" pour activer le mode console/log en dev)
RESEND_API_KEY="re_sample_your_resend_api_key"
EMAIL_FROM="djoonoo <notifications@mail.2krdigital.online>"

# ------------------------------------------------------------------------------
# 5. ENVIRONNEMENT & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 6. INFORMATIONS ÉDITEUR & MENTIONS LÉGALES (Surcharges de src/config/site.ts)
# ------------------------------------------------------------------------------
COMPANY_NAME="ETS. 2KR DIGITAL"
COMPANY_LEGAL_FORM="Établissement"
COMPANY_ADDRESS="Ilôt 251, parcelle C', Cocotomey, Abomey-Calavi, Bénin"
COMPANY_CITY="Abomey-Calavi"
COMPANY_COUNTRY="République du Bénin"
COMPANY_PHONE="+229 01 62 16 91 01"
COMPANY_PHONE_HREF="tel:+2290162169101"
COMPANY_CONTACT_EMAIL="contact@2krdigital.online"
COMPANY_SUPPORT_EMAIL="support@djoonoo.com"
