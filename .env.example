# ==============================================================================
# DJOONOO (ETS. 2KR DIGITAL) — TEMPLATE VARIABLES D'ENVIRONNEMENT (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DONNÉES POSTGRESQL (Supabase / Connection Pooling / Prisma)
# ------------------------------------------------------------------------------
# Connexion poolée (Transaction mode - port 6543 - PgBouncer pour Next.js App Router)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe (Session mode - port 5432 - obligatoire pour migrations Prisma)
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AUTHENTIFICATION & SÉCURITÉ DE SESSION
# ------------------------------------------------------------------------------
# URL publique de l'application (ex: https://app.djoonoo.com ou http://localhost:3000)
# ⚠️ Dans Coolify, cocher impérativement "Build Variable" pour NEXT_PUBLIC_APP_URL
NEXTAUTH_URL="https://app.djoonoo.com"
NEXT_PUBLIC_APP_URL="https://app.djoonoo.com"

# Requis derrière reverse-proxy (Caddy, Traefik, Coolify) pour faire confiance aux en-têtes
AUTH_TRUST_HOST=true

# Clé secrète de signature des sessions JWT (générer avec: openssl rand -hex 32)
# Exigence de sécurité fail-fast : minimum 32 caractères obligatoires
AUTH_SECRET="change-this-to-a-super-secret-key-at-least-32-chars-long"
NEXTAUTH_SECRET="change-this-to-a-super-secret-key-at-least-32-chars-long"

# (Optionnel) Clé secrète dédiée pour isoler la session de la console Super-Admin
SUPERADMIN_AUTH_SECRET="change-this-to-a-dedicated-superadmin-secret-at-least-32-chars"

# ------------------------------------------------------------------------------
# 3. RATE LIMITING DISTRIBUÉ (Optionnel — Upstash Redis / Cluster multi-noeuds)
# ------------------------------------------------------------------------------
# Si non configuré, le rate limiting bascule automatiquement en mémoire locale (in-memory)
# Pour architecture distribuée ou multi-conteneurs, renseigner les clés Upstash REST :
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Alternative standard Redis :
# REDIS_URL="redis://default:[PASSWORD]@[HOST]:[PORT]"

# ------------------------------------------------------------------------------
# 4. EMAILS TRANSACTIONNELS (Resend API)
# ------------------------------------------------------------------------------
# Clé API Resend (laisser vide ou "test_key" pour activer le mode console/log en dev)
RESEND_API_KEY="re_sample_your_resend_api_key"
EMAIL_FROM="djoonoo <notifications@mail.2krdigital.online>"
NOTIFICATION_EMAIL="contact@2krdigital.online"

# ------------------------------------------------------------------------------
# 5. TÂCHES PLANIFIÉES (Cron d'Abonnement — Section 5.4 / Étape 13)
# ------------------------------------------------------------------------------
# Jeton secret requis pour déclencher la route sécurisée POST /api/cron/abonnements
# Exigence fail-fast : minimum 16 caractères obligatoires
CRON_SECRET="change-this-to-a-super-secret-cron-token-at-least-16-chars"

# ------------------------------------------------------------------------------
# 6. PASSERELLE DE PAIEMENT EN LIGNE (FedaPay — Mobile Money MTN / Moov / CB)
# ------------------------------------------------------------------------------
# Clé secrète FedaPay (Dashboard > Paramètres > Clés API : sk_sandbox_... ou sk_live_...)
FEDAPAY_SECRET_KEY="sk_sandbox_your_fedapay_secret_key"

# Clé publique FedaPay pour le widget frontend (pk_sandbox_... ou pk_live_...)
NEXT_PUBLIC_FEDAPAY_PUBLIC_KEY="pk_sandbox_your_fedapay_public_key"

# Clé de signature Webhook (Dashboard > Webhooks > Secret de signature : wh_...)
FEDAPAY_WEBHOOK_SECRET="wh_sandbox_your_fedapay_webhook_secret"

# Environnement FedaPay : "sandbox" (test) ou "live" (production réelle)
FEDAPAY_ENVIRONMENT="sandbox"

# ------------------------------------------------------------------------------
# 7. ENVIRONNEMENT & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 8. INFORMATIONS ÉDITEUR & MENTIONS LÉGALES (Surcharges de src/config/site.ts)
# ------------------------------------------------------------------------------
COMPANY_NAME="ETS. 2KR DIGITAL"
COMPANY_LEGAL_FORM="Établissement"
COMPANY_ADDRESS="Ilôt 251, parcelle C', Cocotomey, Abomey-Calavi, Bénin"
COMPANY_CITY="Abomey-Calavi"
COMPANY_COUNTRY="République du Bénin"
COMPANY_PHONE="+229 01 62 16 91 01"
COMPANY_PHONE_HREF="tel:+2290162169101"
COMPANY_CONTACT_EMAIL="contact@2krdigital.online"
COMPANY_SUPPORT_EMAIL="support@djoonoo.com"
COMPANY_IFU=""
COMPANY_RCCM=""
