# Supabase PostgreSQL Database URLs
# DATABASE_URL utilise le connection pooling Supabase (port 6543) pour Next.js App Router (Section 9)
DATABASE_URL="postgresql://postgres.yourproject:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL utilise la connexion directe PostgreSQL (port 5432) pour les migrations Prisma
DIRECT_URL="postgresql://postgres.yourproject:yourpassword@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Authentification Auth.js (NextAuth v5)
AUTH_SECRET="change-this-to-a-super-secret-key-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Service Email Transactionnel (Section 10 / Décision 5)
RESEND_API_KEY="re_sample_key"

# Tâche planifiée Cron (Section 5.4 / Étape 13)
# Token secret requis pour autoriser l'exécution de /api/cron/abonnements
CRON_SECRET="change-this-to-a-super-secret-cron-token-in-production"

# Sécurité Super-Admin isolée (Optionnel, utilise AUTH_SECRET par défaut si omis)
SUPERADMIN_AUTH_SECRET="change-this-to-a-dedicated-super-admin-secret"
