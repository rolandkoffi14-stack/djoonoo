# ==============================================================================
# DJOONOO (ETS. 2KR DIGITAL) — TEMPLATE VARIABLES D'ENVIRONNEMENT (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DONNÉES POSTGRESQL (Supabase / Connection Pooling)
# ------------------------------------------------------------------------------
# Connexion poolée (Transaction mode - 6543 - pgbouncer pour Next.js App Router)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe (Session mode - 5432 - obligatoire pour les migrations Prisma)
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AUTHENTIFICATION & SÉCURITÉ (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# Pour déploiement VPS / Coolify (Exemple : https://djoonoo.2krdigital.online ou votre domaine)
NEXTAUTH_URL="https://app.djoonoo.com"

# ⚠️ Dans Coolify, cocher "Build Variable" pour NEXT_PUBLIC_APP_URL :
NEXT_PUBLIC_APP_URL="https://app.djoonoo.com"

# Requis derrière Caddy / Coolify reverse-proxy pour faire confiance aux en-têtes d'hôtes
AUTH_TRUST_HOST=true

# Clé secrète de signature des sessions JWT (générer avec: openssl rand -base64 32)
AUTH_SECRET="change-this-to-a-super-secret-key-in-production"
NEXTAUTH_SECRET="change-this-to-a-super-secret-key-in-production"

# (Optionnel) Clé secrète isolée pour la console Super-Admin
SUPERADMIN_AUTH_SECRET="change-this-to-a-dedicated-superadmin-secret"

# ------------------------------------------------------------------------------
# 3. EMAILS TRANSACTIONNELS (Resend API)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_sample_key"
EMAIL_FROM="djoonoo <notifications@mail.2krdigital.online>"
NOTIFICATION_EMAIL="contact@2krdigital.online"

# ------------------------------------------------------------------------------
# 4. TÂCHES PLANIFIÉES (Cron d'Abonnement - Section 5.4 / Étape 13)
# ------------------------------------------------------------------------------
# Token secret requis pour autoriser l'exécution de /api/cron/abonnements
CRON_SECRET="change-this-to-a-super-secret-cron-token-in-production"

# ------------------------------------------------------------------------------
# 5. PASSERELLE DE PAIEMENT EN LIGNE (FedaPay — MTN MoMo / Moov Money / CB)
# ------------------------------------------------------------------------------
# Clé secrète API FedaPay (commence par sk_sandbox_ en test ou sk_live_ en production)
FEDAPAY_SECRET_KEY="sk_sandbox_your_fedapay_secret_key"

# Clé secrète de signature Webhook FedaPay (générée dans votre dashboard FedaPay > Webhooks)
FEDAPAY_WEBHOOK_SECRET="wh_your_fedapay_webhook_secret"

# Environnement FedaPay : "sandbox" (mode test) ou "live" (mode production réelle)
FEDAPAY_ENVIRONMENT="sandbox"

# ------------------------------------------------------------------------------
# 6. ENVIRONNEMENT & SYSTÈME
# ------------------------------------------------------------------------------
NODE_ENV="production"

